.env
.env.local
.env.*.local

# Database
*.db
*.db-journal
backend/data/*.db
backend/data/*.db-journal
!backend/data/snes-metadata.json

# ROMs and Saves (private user data)
backend/roms/
backend/saves/
backend/avatars/

