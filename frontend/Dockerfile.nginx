# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files and install all dependencies
COPY package*.json ./
RUN npm install && \
    npm cache clean --force

# Copy source code and configuration
COPY tsconfig.json ./
COPY svelte.config.js ./
COPY vite.config.ts ./
COPY src ./src
COPY static ./static

# Update PWA configuration for production build
RUN sed -i "s/mode: 'development'/mode: 'production'/" vite.config.ts && \
    sed -i "s/strategies: 'injectManifest'/strategies: 'generateSW'/" vite.config.ts

# Build the SvelteKit app (creates build/ directory with adapter-node)
RUN npm run build

# Production stage with nginx
FROM nginx:alpine

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built application from builder
# SvelteKit with adapter-node creates: build/client (static assets) and build/server (SSR code)
# For static serving, we only need the client directory
COPY --from=builder /app/build/client /usr/share/nginx/html

# Create a healthcheck endpoint
RUN echo '<!DOCTYPE html><html><body>OK</body></html>' > /usr/share/nginx/html/health

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
