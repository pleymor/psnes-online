# Feature Flags - Dual Emulation Mode

# Enable dual emulation mode (beta)
# Set to 'true' to allow users to use dual emulation mode
VITE_ENABLE_DUAL_MODE=true

# Enable input prediction (experimental)
# Predicts missing inputs to smooth gameplay
VITE_ENABLE_INPUT_PREDICTION=false

# Enable performance monitoring
# Tracks FPS, latency, sync rate, etc.
VITE_ENABLE_PERF_MONITORING=true
