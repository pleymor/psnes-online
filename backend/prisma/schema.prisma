generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  googleId      String   @unique
  email         String   @unique
  displayName   String
  avatar        String?
  controlsConfig String? // JSON string containing KeyConfig
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  games         Game[]
  friendshipsInitiated Friendship[] @relation("FriendshipInitiator")
  friendshipsReceived  Friendship[] @relation("FriendshipReceiver")
}

model Friendship {
  id         String   @id @default(uuid())
  status     String   // 'pending', 'accepted', 'rejected'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  initiatorId String
  receiverId  String

  initiator User @relation("FriendshipInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver  User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, receiverId])
}

model GameMetadata {
  id           String   @id @default(uuid())
  title        String
  altTitle     String?  // Alternative title (e.g., Japanese title)
  genre        String?
  publisher    String?
  developer    String?
  releaseDate  String?  // YYYY-MM-DD format
  players      String?  // e.g., "1-2", "1-4"
  region       String?  // NTSC, PAL, NTSC-J
  description  String?
  coverUrl     String?
  crc32        String?  // CRC32 checksum for ROM matching
  md5          String?  // MD5 checksum for ROM matching

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([title])
  @@index([crc32])
}

model Game {
  id          String   @id @default(uuid())
  title       String
  filename    String
  coverUrl    String?
  uploadedAt  DateTime @default(now())

  // No pointer to any file: the ROM stays on the player's machine. This row is
  // the game's identity - title, cover, saves - and `crc32` is what maps it
  // back to a local file at launch.
  //
  // Nullable because the games that predate this change were Drive references
  // and the server never saw their bytes; those are re-linked the first time
  // the player picks the file.

  // Metadata fields
  genre       String?
  publisher   String?
  developer   String?
  releaseDate String?
  players     String?
  region      String?
  description String?
  crc32       String?

  // SRAM (battery save / in-game save data)
  sram        Bytes?
  sramUpdatedAt DateTime?

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  saves       Save[]

  // One entry per cartridge per player: picking the same ROM twice must find
  // the existing game and its saves, not create a second one.
  @@unique([userId, crc32])
}

model Save {
  id          String   @id @default(uuid())
  name        String
  slotNumber  Int
  data        Bytes
  screenshot  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, slotNumber])
}
