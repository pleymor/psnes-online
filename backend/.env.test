NODE_ENV=test
PORT=3001

# Test Database (SQLite file for tests)
# Enable WAL mode for better concurrent access and increased connection pool
DATABASE_URL="file:./test.db?connection_limit=20&journal_mode=WAL"

# Redis for tests
REDIS_HOST=localhost
REDIS_PORT=6380

# Auth mode for tests
AUTH_MODE=dev

# Session
SESSION_SECRET=test-secret-key

# Google OAuth (test values)
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Storage
ROMS_DIR=./test-roms
SAVES_DIR=./test-saves
