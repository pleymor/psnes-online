NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="file:./dev.db"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Session
SESSION_SECRET=your-secret-key-change-in-production

# Token encryption key (generate with: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key-generate-with-openssl

# Authentication Mode: "google" or "dev"
# In dev mode, you can choose between predefined test users
AUTH_MODE=dev

# Google OAuth (only required if AUTH_MODE=google)
# Note: Drive scope is required for Google Drive integration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Storage
ROM_CACHE_DIR=./rom-cache
SAVES_DIR=./saves
